# Africa's Talking SMS API Configuration
# Replace with your Africa's Talking username (or 'sandbox' for testing)
AT_USERNAME=sandbox

# Your Africa's Talking API Key (generated in the Africa's Talking Dashboard)
AT_API_KEY=your_africastalking_api_key_here

# Optional custom Alphanumeric Sender ID or Shortcode (leave empty if none)
AT_SENDER_ID=

# Environment: 'sandbox' or 'production'
AT_ENV=sandbox
