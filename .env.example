# Africa's Talking SMS. Use sandbox for development; production requires an
# approved Africa's Talking account and sender ID where applicable.
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
# Leave blank in the sandbox unless Africa's Talking instructs you to use
# a particular sandbox sender. Use an approved alphanumeric sender in production.
AT_SENDER_ID=
AT_ENV=sandbox
